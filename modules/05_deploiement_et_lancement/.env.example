# 1. Clés Stripe officielles (Mode Live)
STRIPE_SECRET_KEY=rk_live_votre_cle_ici
STRIPE_PAYMENT_LINK_URL=https://buy.stripe.com/5kQ5kDeuJ6BJ2js7YE8N201
# Secret de signature fourni par Stripe Dashboard lors de l'ajout de l'URL Webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# 2. Configuration Email d'Expédition (Canal Gratuit 0 €)
# Option A : Brevo SMTP Gratuit (recommandé jusqu'à 300 mails/jour)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=votre_email_compte_brevo
# SMTP_PASSWORD=votre_cle_smtp_brevo

# Option B : Gmail SMTP (avec Mot de passe d'application 16 caractères)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=votre_adresse@gmail.com
# SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Option C : Resend API
# RESEND_API_KEY=re_123456789

# Identité affichée pour l'expéditeur
FROM_EMAIL=AutoBiz IA <contact@autobiz-ia.fr>
SENDER_NAME=Corentin — AutoBiz IA
SUPPORT_EMAIL=contact@autobiz-ia.fr

# Port Cloud (automatiquement injecté par Render/Koyeb)
PORT=5000
