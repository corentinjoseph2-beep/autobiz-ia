# ==============================================================================
# Configuration AutoBiz IA — Module 04 : Paiement & Livraison Automatique
# ==============================================================================

# 1. Clés d'API Stripe (Récupérées sur dashboard.stripe.com/apikeys)
# Utiliser les clés sk_test_... en phase de test, puis sk_live_... en production
STRIPE_SECRET_KEY=sk_test_votre_cle_secrete_ici
STRIPE_WEBHOOK_SECRET=whsec_votre_secret_webhook_ici

# 2. Configuration Email Expéditeur
FROM_EMAIL=AutoBiz IA <contact@votre-domaine.fr>
SUPPORT_EMAIL=contact@votre-domaine.fr

# 3. Méthode d'envoi d'emails (Option A: SMTP classique, Option B: API Resend)
# Option A : SMTP (Brevo, Gmail, Mailjet, OVH...)
# Si laissé vide ou par défaut, le script enregistre les emails dans outbox/ (Mode Simulation)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=votre-identifiant@domaine.com
SMTP_PASSWORD=votre-mot-de-passe-smtp

# Option B : Resend (Alternative sans SMTP - https://resend.com)
RESEND_API_KEY=

# 4. Paramètres Serveur Webhook
PORT=5000
HOST=0.0.0.0
DEBUG=true
